# apps/social/.env — 이 파일을 .env 로 복사해 값을 채운다. .env 는 git 에 올라가지 않는다(.gitignore).
# 토큰은 채팅·문서에 붙여넣지 말 것. Threads/Instagram 토큰은 `node tokens.mjs` 가 직접 써 넣는다.
ANTHROPIC_API_KEY=
# Meta 앱 "HAVIT Social Publisher" (앱 설정 → 기본 설정)
META_APP_ID=2417293725470073
META_APP_SECRET=
THREADS_APP_ID=1160348523081788
THREADS_APP_SECRET=
THREADS_REDIRECT_URI=https://www.aihavit.com/
# 이미지 공개 호스팅 (aws login 필요)
SOCIAL_MEDIA_BUCKET=havit-prod-us-east
SOCIAL_MEDIA_PREFIX=image/sns
# 매일 요약
SLACK_WEBHOOK_URL=
# 아래는 tokens.mjs 가 채운다: IG_TOKEN_KO, IG_TOKEN_KO_EXPIRES, THREADS_TOKEN_KO, ... (KO JA EN ZH_TW ES PT_BR ID DE FR)
